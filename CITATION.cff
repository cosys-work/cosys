    given-names: Risav
    affiliation: "CoSys Work Pvt. Ltd."
repository-code: "https://github.com/cosys-work/cosys"
url: "https://cosys.work"
license: Apache-2.0
keywords:
  - Lean 4
  - applied category theory
  - polynomial functors
  - Mealy machines
  - local-first software
